APP_NAME=Kertai
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development runs on SQLite. Production uses PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=kertai
# DB_USERNAME=kertai
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Messages and payment checks run on the queue. Production: redis.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel's own mailer. Used for email unless a provider is saved under
# Administration > Integrations (which then takes precedence).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="kertai@example.com"
MAIL_FROM_NAME="KERTAI006 Self Help Group"

# ---------------------------------------------------------------------------
# Providers. Everything below can instead be entered in the app under
# Administration > Integrations, where keys are stored encrypted. Values
# saved in the app win over these.
# ---------------------------------------------------------------------------

# SMS: onfon, africastalking, advanta, http or log (writes to the log only)
SMS_DRIVER=log
SMS_SENDER_ID=KERTAI006

ONFON_API_KEY=
ONFON_CLIENT_ID=
ONFON_ACCESS_KEY=

AT_USERNAME=
AT_API_KEY=
AT_SANDBOX=false

ADVANTA_API_KEY=
ADVANTA_PARTNER_ID=

SMS_HTTP_URL=
SMS_HTTP_HEADERS="{}"
SMS_HTTP_BODY="{\"to\":\"{to}\",\"message\":\"{message}\",\"from\":\"{sender}\"}"
SMS_HTTP_SUCCESS_CONTAINS=

# Secret path for inbound SMS (members text BAL). Point the provider's
# inbound URL at https://your-domain/webhooks/sms/<this token>.
INBOUND_SMS_TOKEN=

# Email provider override: default, smtp, mailgun, postmark, ses, log
KERTAI_EMAIL_DRIVER=default

# Payments: simulinkpay or fake (development: prompts succeed on check)
PAYMENTS_DRIVER=fake
SIMULINKPAY_BASE_URL=https://simulinkpay.co.ke
SIMULINKPAY_TOKEN=
SIMULINKPAY_RECEIVING_ACCOUNT_ID=
SIMULINKPAY_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
